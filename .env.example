# Jina AI API Key (Get free key at https://jina.ai/embeddings)
JINA_API_KEY=your_jina_api_key_here

# Groq Cloud API Key (Get free key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Optional / fallback - https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# ChromaDB & Document storage directories (relative or absolute persistent path)
CHROMA_PATH=chroma
DATA_FOLDER=data

# Web server port (Default: 8000; Render will set this automatically)
PORT=8000
